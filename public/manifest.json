{
  "manifest_version": 3,
  "name": "Vue Extension Demo",
  "version": "1.0.0",
  "description": "A Chrome extension built with Vue, Vite, and TailwindCSS",
  "action": {
    "default_title": "点击打开侧边栏",
    "default_icon": {
      "16": "icons/iconx16.png",
      "48": "icons/iconx48.png",
      "128": "icons/iconx128.png"
    }
  },
  "icons": {
    "16": "icons/iconx16.png",
    "48": "icons/iconx48.png",
    "128": "icons/iconx128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "permissions": ["activeTab", "storage", "sidePanel"],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
